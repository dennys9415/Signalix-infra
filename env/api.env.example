NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://signalix:signalix_password@postgres:5432/signalix_dev
JWT_SECRET=replace_me_locally
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000


GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

APPLE_CLIENT_ID=your_apple_client_id_here
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY=your_apple_private_key_here
APPLE_CALLBACK_URL=your_apple_callback_url_here


# Email (Resend) — https://resend.com
# Leave RESEND_API_KEY empty to skip sending and log the reset URL to the console instead.
# For local testing, onboarding@resend.dev is a pre-verified Resend sandbox sender.
RESEND_API_KEY=
EMAIL_FROM=Signalix <onboarding@resend.dev>

# MinIO object storage (S3-compatible)
# MINIO_ENDPOINT: internal Docker URL used by the API container
# MINIO_PUBLIC_URL: externally accessible URL used to build avatar URLs stored in the DB
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=signalix
MINIO_SECRET_KEY=signalix_minio_password
MINIO_BUCKET_AVATARS=signalix-avatars
MINIO_BUCKET_MEDIA=signalix-media
MINIO_BUCKET_FILES=signalix-files
